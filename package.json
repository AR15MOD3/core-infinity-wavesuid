{
  "name": "core-infinity-wavesuid",
  "version": "0.4.3",
  "repository": "https://github.com/AR15MOD3/core-infinity-wavesuid",
  "author": "AR15MOD3",
  "license": "GPL-3.0-or-later",
  "description": "通过同一 Bot 的 QQ 连接将群内 ww 命令直接交给原生 GsCore。兼容既有 Rover 查询：角色与武器查询、面板、深渊、抽卡、体力、排行。非官方移植。",
  "keywords": [
    "core-infinity",
    "telyincore",
    "wuthering-waves",
    "鸣潮"
  ],
  "main": "index.py",
  "telyincore": {
    "kind": "infinity",
    "api": 1,
    "botScope": 1,
    "displayName": "鸣潮查询",
    "icon": "grid",
    "configSchema": "config.schema.json",
    "configPage": "config.html",
    "pageBackend": "account_admin.py",
    "pageBackendApi": 1,
    "pageActions": {
      "accounts": {
        "mutates": false,
        "label": "读取账号名单"
      },
      "delete_account": {
        "mutates": true,
        "label": "删除本 Bot 保存的账号绑定和登录凭证"
      },
      "environment": {
        "mutates": false,
        "label": "检测当前 Bot 的鸣潮运行环境"
      },
      "install_native": {
        "mutates": true,
        "label": "为当前 Bot 下载并安装原生鸣潮依赖和 Chromium"
      }
    }
  }
}
