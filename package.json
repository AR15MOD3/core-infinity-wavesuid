  "description": "把 XutheringWavesUID 的鸣潮查询接进 TelyinCore：角色与武器查询、面板、深渊、抽卡、体力、排行。非官方移植。",
  "keywords": [
    "core-infinity",
    "telyincore",
    "wuthering-waves",
    "鸣潮"
  ],
  "main": "index.py",
  "telyincore": {
    "kind": "infinity",
    "api": 1,
    "botScope": 1,
    "displayName": "鸣潮查询",
    "icon": "grid",
    "configSchema": "config.schema.json",
    "configPage": "config.html",
    "pageBackend": "account_admin.py",
    "pageBackendApi": 1,
    "pageActions": {
      "accounts": {
        "mutates": false,
        "label": "读取账号名单"
      },
      "delete_account": {
        "mutates": true,
        "label": "删除本 Bot 保存的账号绑定和登录凭证"
      }
    }
  }
}
